ANTHROPIC_API_KEY=               # (legacy - no longer used)

# ── LLM Provider ──────────────────────────────────────────────────────────────
# "gemini" (default) or "openai" (covers OpenAI + any OpenAI-compatible API)
LLM_PROVIDER=gemini   # gemini | openai | openrouter

# ── Gemini (LLM_PROVIDER=gemini) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI / OpenAI-compatible (LLM_PROVIDER=openai) ─────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Leave empty for official OpenAI. Set to custom base URL for compatible APIs:
#   Ollama (local):   http://localhost:11434/v1
#   Together AI:      https://api.together.xyz/v1
#   Groq:             https://api.groq.com/openai/v1
#   Mistral:          https://api.mistral.ai/v1
#   LM Studio:        http://localhost:1234/v1
OPENAI_BASE_URL=

# ── OpenRouter (LLM_PROVIDER=openrouter) ─────────────────────────────────────
# Model is runtime-selectable from a dropdown in the UI (list fetched from
# https://openrouter.ai/api/v1/models with your key); this is the startup default.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Data ──────────────────────────────────────────────────────────────────────
# All runtime state (database, uploads, outputs, models, batches). Default: ./volumes
# PHOTON_VOLUMES_DIR=

# ── Loop + Sandbox ────────────────────────────────────────────────────────────
MAX_LOOP_ITERATIONS=6
EXECUTION_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=200
SANDBOX_MEMORY_LIMIT_GB=8
# BLAS/OpenMP threads inside sandboxed code (keep 1 on many-core machines)
SANDBOX_BLAS_THREADS=1

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production

# ── Google OAuth (OPTIONAL — leave blank to disable; app falls back to
#    username/password only) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Who may create an account (D-037) ─────────────────────────────────────────
# open | invite | closed (default: closed). closed = accounts only via
#   python -m src.backend.cli user add <username> <email>
# (also how a fresh install gets its first account). open = anyone who reaches
# the login page; only with an allow-list below or on a private network.
PHOTON_SIGNUP=closed
# If either list is set, new accounts must match it (Google must also verify the email).
PHOTON_SIGNUP_ALLOWED_DOMAINS=
PHOTON_SIGNUP_ALLOWED_EMAILS=
# Required for password sign-up when PHOTON_SIGNUP=invite.
PHOTON_SIGNUP_INVITE_CODE=

# ── Where untrusted code runs (D-038) ─────────────────────────────────────────
# local = subprocess on this host (default). remote = gVisor sandbox worker,
# see docker/sandbox-worker/README.md.
PHOTON_SANDBOX=local
PHOTON_SANDBOX_URL=
PHOTON_SANDBOX_TOKEN=
# Remote mode limits: largest result the app accepts from the worker; on the worker
# itself, largest job input (default = MAX_UPLOAD_MB) and concurrent jobs.
# PHOTON_SANDBOX_MAX_RESULT_MB=512
# PHOTON_SANDBOX_MAX_INPUT_MB=200
# PHOTON_SANDBOX_WORKER_SLOTS=2

# ── Fetching images by URL (MCP upload_image / upload_images url=...) ─────────
# Private / loopback addresses are refused (SSRF). Set 1 only on a trusted network.
# PHOTON_ALLOW_PRIVATE_URLS=0

# ── Disk housekeeping (D-048) ─────────────────────────────────────────────────
# Per-user storage cap in GB (uploads + session/batch outputs + models); 0 = none.
PHOTON_USER_QUOTA_GB=0
# Delete finished batches (results, not source images) older than N days; 0 = keep.
PHOTON_BATCH_RETENTION_DAYS=0
# Keep each run's scratch folder in volumes/tmp_exec for debugging (normally deleted).
# PHOTON_KEEP_SCRATCH=1

# ── Batch runs (D-046) ────────────────────────────────────────────────────────
# Images processed in parallel (each is its own sandbox process; raise on big hosts).
PHOTON_BATCH_WORKERS=2
# Largest batch.
PHOTON_BATCH_MAX_IMAGES=2000

# ── Uploaded segmentation models (D-047) ──────────────────────────────────────
# Needs: uv sync --extra models. Largest weights file (browser uploads are also
# capped by MAX_UPLOAD_MB).
PHOTON_MAX_MODEL_MB=500

# ── GPU model lifecycle (v3 P4) ───────────────────────────────────────────────
# Models load on demand and unload after this many seconds idle (5 min default).
MODEL_IDLE_TIMEOUT_SECONDS=300
# Ceiling on VRAM held by loaded models; 0 = half the device's memory.
MODEL_VRAM_BUDGET_MB=0
# auto | cuda | cpu
MODEL_DEVICE=auto
# The sidecar *process* exits after this long idle with nothing loaded (0 disables;
# code default 1800). Models leave the GPU after MODEL_IDLE_TIMEOUT_SECONDS either
# way; keeping the process costs ~1-2 GB RAM + ~0.4 GB VRAM (CUDA context) but
# saves re-importing torch, which takes 60-85 s when the venv is on Lustre/NFS.
MODEL_SIDECAR_IDLE_EXIT_SECONDS=86400
# Advanced: how often idle models are checked; run model ops in-process instead
# of the sidecar (0, tests only); sidecar socket path (default volumes/model_sidecar.sock).
# MODEL_REAPER_INTERVAL_SECONDS=15
# MODEL_SIDECAR_ENABLED=1
# MODEL_SIDECAR_SOCKET=

# ── MCP server (python -m src.mcp_server) ─────────────────────────────────────
# stdio = local single user (PHOTON_MCP_USER); http = API keys from the web UI.
# PHOTON_MCP_TRANSPORT=stdio
# PHOTON_MCP_HOST=0.0.0.0
# PHOTON_MCP_PORT=8890
# Username or email the stdio transport acts as (ignored over http).
# PHOTON_MCP_USER=
# URL clients use to reach /mcp (behind a proxy / port-forward); shown on the API keys page.
# PHOTON_MCP_PUBLIC_URL=http://172.20.23.234:10227/mcp
# Base URL of the web app, advertised as the auth issuer (default: derived from the MCP URL).
# PHOTON_PUBLIC_URL=
# Over http, server-side paths (upload_image/upload_images path=, register_seg_model
# weights_path=) are refused unless inside these directories (os.pathsep-separated).
# PHOTON_MCP_PATH_ROOTS=/data/slides:/data/models
# Largest file download_output returns; long edge of previews in tool results.
# PHOTON_MCP_MAX_DOWNLOAD_MB=25
# PHOTON_MCP_PREVIEW_EDGE=512
