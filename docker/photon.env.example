# Compose-level settings for docker/docker-compose.yml:
#   cp photon.env.example photon.env && docker compose --env-file ../.env --env-file photon.env up -d --build
# App settings (LLM keys, FLASK_SECRET_KEY, sign-up policy, ...) and ports stay in ../.env.

# Absolute path of Photon's data folder (database, uploads, outputs, models).
# Mounted at the SAME path inside the containers: the database stores absolute
# paths, so an existing install keeps working if you point this at its volumes/.
PHOTON_DATA_DIR=/home/mohittewari/Photon/volumes

# Owner of PHOTON_DATA_DIR on the host (`id -u`, `id -g`): the containers run as
# this user so files stay editable outside Docker.
PHOTON_UID=1000
PHOTON_GID=1000

# Interface for the one published port (PHOTON_PORT in ../.env, Caddy).
# 127.0.0.1 keeps it off other machines.
PHOTON_BIND=0.0.0.0

# The MCP URL clients use, shown on the API-keys page (behind a proxy / port-forward).
PHOTON_MCP_PUBLIC_URL=

# A host folder MCP clients may read with upload_images(paths=[...]) / register_model(weights_path=...).
# Mounted read-only at the same path; also list it in PHOTON_MCP_PATH_ROOTS (":"-separated).
# Leave both empty to disable server-side paths (clients then send files as base64 / URLs).
PHOTON_MCP_READ_DIR=
PHOTON_MCP_PATH_ROOTS=

# Keep the model sidecar process (with torch imported) alive this long when idle.
# Models still leave the GPU after MODEL_IDLE_TIMEOUT_SECONDS (5 min).
MODEL_SIDECAR_IDLE_EXIT_SECONDS=86400
